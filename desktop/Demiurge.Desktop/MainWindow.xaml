<Window x:Class="Demiurge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Demiurge"
        Width="1280" Height="860" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#101216">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
        <Border x:Name="Overlay" Background="#101216">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" Margin="36">
                <TextBlock Text="Demiurge"
                           FontSize="34" FontWeight="SemiBold" Foreground="#F2F4F8"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="正在启动…"
                           FontSize="15" Foreground="#AEB6C4"
                           HorizontalAlignment="Center" Margin="0,18,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="DetailText"
                           FontSize="12" Foreground="#7C8595"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,22,0,0" Visibility="Collapsed">
                    <Button x:Name="RetryButton" Content="重试" Padding="18,8" Margin="0,0,10,0"
                            Click="RetryButton_Click" />
                    <Button x:Name="OpenBrowserButton" Content="打开日志目录" Padding="18,8"
                            Click="OpenBrowserButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
