  IfFileExists "$DemiurgeShellHome\userdata\regex_scripts.json" 0 d92
  Delete "$DemiurgeShellHome\userdata\regex_scripts.json"
  IfFileExists "$DemiurgeShellHome\userdata\regex_scripts.json" d91 d90
  d90:
  StrCpy $R8 "OK    userdata/regex_scripts.json"
  Call un.DemiurgeLog
  Goto d92
  d91:
  StrCpy $R8 "KEEP  userdata/regex_scripts.json"
  Call un.DemiurgeLog
  d92:
  ; [settings] userdata/remote_backend.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\remote_backend.json" 0 d95
  Delete "$DemiurgeShellHome\userdata\remote_backend.json"
  IfFileExists "$DemiurgeShellHome\userdata\remote_backend.json" d94 d93
  d93:
  StrCpy $R8 "OK    userdata/remote_backend.json"
  Call un.DemiurgeLog
  Goto d95
  d94:
  StrCpy $R8 "KEEP  userdata/remote_backend.json"
  Call un.DemiurgeLog
  d95:
  ; [settings] userdata/user_state.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\user_state.json" 0 d98
  Delete "$DemiurgeShellHome\userdata\user_state.json"
  IfFileExists "$DemiurgeShellHome\userdata\user_state.json" d97 d96
  d96:
  StrCpy $R8 "OK    userdata/user_state.json"
  Call un.DemiurgeLog
  Goto d98
  d97:
  StrCpy $R8 "KEEP  userdata/user_state.json"
  Call un.DemiurgeLog
  d98:
  IfFileExists "$DemiurgeShellHome\userdata\user_state.json.bak-*" 0 demiurge_bak_99
  Delete "$DemiurgeShellHome\userdata\user_state.json.bak-*"
  StrCpy $R8 "BAK   userdata/user_state.json.bak-*"
  Call un.DemiurgeLog
  demiurge_bak_99:
  StrCpy $DemiurgeUninstMsg "$(DemiurgeUninstWiped)$DemiurgeShellHome\userdata"
  MessageBox MB_OK|MB_ICONINFORMATION "$DemiurgeUninstMsg" /SD IDOK
  StrCpy $R8 "MSG   completion: settings removed, product kept"
  Call un.DemiurgeLog
  Goto demiurge_done
  demiurge_settings_no:
  StrCpy $R8 "SKIP  settings (checkbox off)"
  Call un.DemiurgeLog
  StrCpy $DemiurgeUninstMsg "$(DemiurgeUninstKeep)$DemiurgeShellHome"
  MessageBox MB_OK|MB_ICONINFORMATION "$DemiurgeUninstMsg" /SD IDOK
  StrCpy $R8 "MSG   completion: everything kept under shell home"
  Call un.DemiurgeLog
  Goto demiurge_done
  demiurge_update_skip:
  StrCpy $R8 "SKIP  update mode (keep runtime and data)"
  Call un.DemiurgeLog
  Goto demiurge_done
  demiurge_done:
  StrCpy $R8 "KEEP  product (repos, presets, cards, worldbooks, rag index, weights)"
  Call un.DemiurgeLog
!macroend
