; Generated by scripts/generate_uninstall_hooks.py - do not edit.
; Source of truth: backend/app/data_layout.py (tiers: cache / settings / product).
; cache is always removed; settings only when "Delete the application data" is checked;
; product / container / unregistered names never appear here.
; ASCII only: NSIS decides script encoding from a BOM, and the receipt text must stay readable.
; The completion popup text is a LangString from the language override files; this script only
; references it and appends the resolved shell home, so an override of DEMIURGE_SHELL_HOME shows.

Var /GLOBAL DemiurgeShellHome
Var /GLOBAL DemiurgeUninstMsg

Function un.DemiurgeLog
  ; Append one line to uninstall.log in the shell home; DetailPrint only when home is absent.
  IfFileExists "$DemiurgeShellHome\*.*" 0 un_demiurge_log_missing
  ClearErrors
  FileOpen $9 "$DemiurgeShellHome\uninstall.log" a
  IfErrors un_demiurge_log_missing
  ; NSIS "a" opens at byte 0, so without this seek every line overwrites the previous one.
  FileSeek $9 0 END
  FileWrite $9 "$R8$\r$\n"
  FileClose $9
  un_demiurge_log_missing:
  DetailPrint "$R8"
  Return
FunctionEnd

!macro NSIS_HOOK_POSTUNINSTALL
  SetShellVarContext current
  ; Same rule as Rust paths::home(): DEMIURGE_SHELL_HOME wins over %LOCALAPPDATA%\Demiurge.
  StrCpy $DemiurgeShellHome "$LOCALAPPDATA\Demiurge"
  ReadEnvStr $0 DEMIURGE_SHELL_HOME
  StrCmp $0 "" demiurge_home_default
  StrCpy $DemiurgeShellHome $0
  demiurge_home_default:
  ; Updates re-run the old uninstaller silently: delete nothing in that mode.
  ; StrCmp, not IntCmp: an uninitialized var is "" and NSIS IntCmp does not rank "" below 1,
  ; which would skip every normal uninstall. tauri's own template uses LogicLib = (StrCmp).
  StrCmp $UpdateMode 1 demiurge_update_skip demiurge_start
  demiurge_start:
  StrCpy $R8 "=== uninstall: cache always, settings only if checked ==="
  Call un.DemiurgeLog

  ; tier 1 cache: unconditional
  ; [cache] shell-home/downloads (dir)
  IfFileExists "$DemiurgeShellHome\downloads\*.*" 0 d2
  RmDir /r "$DemiurgeShellHome\downloads"
  IfFileExists "$DemiurgeShellHome\downloads\*.*" d1 d0
  d0:
  StrCpy $R8 "OK    shell-home/downloads"
  Call un.DemiurgeLog
  Goto d2
  d1:
  StrCpy $R8 "KEEP  shell-home/downloads"
  Call un.DemiurgeLog
  d2:
  ; [cache] shell-home/logs (dir)
  IfFileExists "$DemiurgeShellHome\logs\*.*" 0 d5
  RmDir /r "$DemiurgeShellHome\logs"
  IfFileExists "$DemiurgeShellHome\logs\*.*" d4 d3
  d3:
  StrCpy $R8 "OK    shell-home/logs"
  Call un.DemiurgeLog
  Goto d5
  d4:
  StrCpy $R8 "KEEP  shell-home/logs"
  Call un.DemiurgeLog
  d5:
  ; [cache] shell-home/runtime (dir)
  IfFileExists "$DemiurgeShellHome\runtime\*.*" 0 d8
  RmDir /r "$DemiurgeShellHome\runtime"
  IfFileExists "$DemiurgeShellHome\runtime\*.*" d7 d6
  d6:
  StrCpy $R8 "OK    shell-home/runtime"
  Call un.DemiurgeLog
  Goto d8
  d7:
  StrCpy $R8 "KEEP  shell-home/runtime"
  Call un.DemiurgeLog
  d8:
  ; [cache] shell-home/runtime.pid (file)
  IfFileExists "$DemiurgeShellHome\runtime.pid" 0 d11
  Delete "$DemiurgeShellHome\runtime.pid"
  IfFileExists "$DemiurgeShellHome\runtime.pid" d10 d9
  d9:
  StrCpy $R8 "OK    shell-home/runtime.pid"
  Call un.DemiurgeLog
  Goto d11
  d10:
  StrCpy $R8 "KEEP  shell-home/runtime.pid"
  Call un.DemiurgeLog
  d11:
  ; [cache] userdata/builtin_agents.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\builtin_agents.json" 0 d14
  Delete "$DemiurgeShellHome\userdata\builtin_agents.json"
  IfFileExists "$DemiurgeShellHome\userdata\builtin_agents.json" d13 d12
  d12:
  StrCpy $R8 "OK    userdata/builtin_agents.json"
  Call un.DemiurgeLog
  Goto d14
  d13:
  StrCpy $R8 "KEEP  userdata/builtin_agents.json"
  Call un.DemiurgeLog
  d14:
  ; [cache] userdata/comfyui_node_cache (dir)
  IfFileExists "$DemiurgeShellHome\userdata\comfyui_node_cache\*.*" 0 d17
  RmDir /r "$DemiurgeShellHome\userdata\comfyui_node_cache"
  IfFileExists "$DemiurgeShellHome\userdata\comfyui_node_cache\*.*" d16 d15
  d15:
  StrCpy $R8 "OK    userdata/comfyui_node_cache"
  Call un.DemiurgeLog
  Goto d17
  d16:
  StrCpy $R8 "KEEP  userdata/comfyui_node_cache"
  Call un.DemiurgeLog
  d17:
  ; [cache] userdata/delivery.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\delivery.json" 0 d20
  Delete "$DemiurgeShellHome\userdata\delivery.json"
  IfFileExists "$DemiurgeShellHome\userdata\delivery.json" d19 d18
  d18:
  StrCpy $R8 "OK    userdata/delivery.json"
  Call un.DemiurgeLog
  Goto d20
  d19:
  StrCpy $R8 "KEEP  userdata/delivery.json"
  Call un.DemiurgeLog
  d20:
  ; [cache] userdata/exports (dir)
  IfFileExists "$DemiurgeShellHome\userdata\exports\*.*" 0 d23
  RmDir /r "$DemiurgeShellHome\userdata\exports"
  IfFileExists "$DemiurgeShellHome\userdata\exports\*.*" d22 d21
  d21:
  StrCpy $R8 "OK    userdata/exports"
  Call un.DemiurgeLog
  Goto d23
  d22:
  StrCpy $R8 "KEEP  userdata/exports"
  Call un.DemiurgeLog
  d23:
  ; [cache] userdata/logs (dir)
  IfFileExists "$DemiurgeShellHome\userdata\logs\*.*" 0 d26
  RmDir /r "$DemiurgeShellHome\userdata\logs"
  IfFileExists "$DemiurgeShellHome\userdata\logs\*.*" d25 d24
  d24:
  StrCpy $R8 "OK    userdata/logs"
  Call un.DemiurgeLog
  Goto d26
  d25:
  StrCpy $R8 "KEEP  userdata/logs"
  Call un.DemiurgeLog
  d26:
  ; [cache] userdata/numba_cache (dir)
  IfFileExists "$DemiurgeShellHome\userdata\numba_cache\*.*" 0 d29
  RmDir /r "$DemiurgeShellHome\userdata\numba_cache"
  IfFileExists "$DemiurgeShellHome\userdata\numba_cache\*.*" d28 d27
  d27:
  StrCpy $R8 "OK    userdata/numba_cache"
  Call un.DemiurgeLog
  Goto d29
  d28:
  StrCpy $R8 "KEEP  userdata/numba_cache"
  Call un.DemiurgeLog
  d29:
  ; [cache] userdata/task_progress (dir)
  IfFileExists "$DemiurgeShellHome\userdata\task_progress\*.*" 0 d32
  RmDir /r "$DemiurgeShellHome\userdata\task_progress"
  IfFileExists "$DemiurgeShellHome\userdata\task_progress\*.*" d31 d30
  d30:
  StrCpy $R8 "OK    userdata/task_progress"
  Call un.DemiurgeLog
  Goto d32
  d31:
  StrCpy $R8 "KEEP  userdata/task_progress"
  Call un.DemiurgeLog
  d32:
  ; [cache] userdata/temp (dir)
  IfFileExists "$DemiurgeShellHome\userdata\temp\*.*" 0 d35
  RmDir /r "$DemiurgeShellHome\userdata\temp"
  IfFileExists "$DemiurgeShellHome\userdata\temp\*.*" d34 d33
  d33:
  StrCpy $R8 "OK    userdata/temp"
  Call un.DemiurgeLog
  Goto d35
  d34:
  StrCpy $R8 "KEEP  userdata/temp"
  Call un.DemiurgeLog
  d35:
  ; [cache] userdata/thumbs (dir)
  IfFileExists "$DemiurgeShellHome\userdata\thumbs\*.*" 0 d38
  RmDir /r "$DemiurgeShellHome\userdata\thumbs"
  IfFileExists "$DemiurgeShellHome\userdata\thumbs\*.*" d37 d36
  d36:
  StrCpy $R8 "OK    userdata/thumbs"
  Call un.DemiurgeLog
  Goto d38
  d37:
  StrCpy $R8 "KEEP  userdata/thumbs"
  Call un.DemiurgeLog
  d38:
  ; [cache] userdata/tmp (dir)
  IfFileExists "$DemiurgeShellHome\userdata\tmp\*.*" 0 d41
  RmDir /r "$DemiurgeShellHome\userdata\tmp"
  IfFileExists "$DemiurgeShellHome\userdata\tmp\*.*" d40 d39
  d39:
  StrCpy $R8 "OK    userdata/tmp"
  Call un.DemiurgeLog
  Goto d41
  d40:
  StrCpy $R8 "KEEP  userdata/tmp"
  Call un.DemiurgeLog
  d41:
  ; [cache] userdata/transfer (dir)
  IfFileExists "$DemiurgeShellHome\userdata\transfer\*.*" 0 d44
  RmDir /r "$DemiurgeShellHome\userdata\transfer"
  IfFileExists "$DemiurgeShellHome\userdata\transfer\*.*" d43 d42
  d42:
  StrCpy $R8 "OK    userdata/transfer"
  Call un.DemiurgeLog
  Goto d44
  d43:
  StrCpy $R8 "KEEP  userdata/transfer"
  Call un.DemiurgeLog
  d44:
  ; [cache] userdata/wallpaper_thumbs (dir)
  IfFileExists "$DemiurgeShellHome\userdata\wallpaper_thumbs\*.*" 0 d47
  RmDir /r "$DemiurgeShellHome\userdata\wallpaper_thumbs"
  IfFileExists "$DemiurgeShellHome\userdata\wallpaper_thumbs\*.*" d46 d45
  d45:
  StrCpy $R8 "OK    userdata/wallpaper_thumbs"
  Call un.DemiurgeLog
  Goto d47
  d46:
  StrCpy $R8 "KEEP  userdata/wallpaper_thumbs"
  Call un.DemiurgeLog
  d47:

  ; tier 2 settings: only when the app-data checkbox is checked
  StrCmp $DeleteAppDataCheckboxState 1 demiurge_settings_yes demiurge_settings_no
  demiurge_settings_yes:
  ; [settings] shell-home/desktop.json (file)
  IfFileExists "$DemiurgeShellHome\desktop.json" 0 d50
  Delete "$DemiurgeShellHome\desktop.json"
  IfFileExists "$DemiurgeShellHome\desktop.json" d49 d48
  d48:
  StrCpy $R8 "OK    shell-home/desktop.json"
  Call un.DemiurgeLog
  Goto d50
  d49:
  StrCpy $R8 "KEEP  shell-home/desktop.json"
  Call un.DemiurgeLog
  d50:
  ; [settings] shell-home/webview2 (dir)
  IfFileExists "$DemiurgeShellHome\webview2\*.*" 0 d53
  RmDir /r "$DemiurgeShellHome\webview2"
  IfFileExists "$DemiurgeShellHome\webview2\*.*" d52 d51
  d51:
  StrCpy $R8 "OK    shell-home/webview2"
  Call un.DemiurgeLog
  Goto d53
  d52:
  StrCpy $R8 "KEEP  shell-home/webview2"
  Call un.DemiurgeLog
  d53:
  ; [settings] userdata/agent_plugins.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\agent_plugins.json" 0 d56
  Delete "$DemiurgeShellHome\userdata\agent_plugins.json"
  IfFileExists "$DemiurgeShellHome\userdata\agent_plugins.json" d55 d54
  d54:
  StrCpy $R8 "OK    userdata/agent_plugins.json"
  Call un.DemiurgeLog
  Goto d56
  d55:
  StrCpy $R8 "KEEP  userdata/agent_plugins.json"
  Call un.DemiurgeLog
  d56:
  ; [settings] userdata/capability_leases.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\capability_leases.json" 0 d59
  Delete "$DemiurgeShellHome\userdata\capability_leases.json"
  IfFileExists "$DemiurgeShellHome\userdata\capability_leases.json" d58 d57
  d57:
  StrCpy $R8 "OK    userdata/capability_leases.json"
  Call un.DemiurgeLog
  Goto d59
  d58:
  StrCpy $R8 "KEEP  userdata/capability_leases.json"
  Call un.DemiurgeLog
  d59:
  ; [settings] userdata/comfy_config.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\comfy_config.json" 0 d62
  Delete "$DemiurgeShellHome\userdata\comfy_config.json"
  IfFileExists "$DemiurgeShellHome\userdata\comfy_config.json" d61 d60
  d60:
  StrCpy $R8 "OK    userdata/comfy_config.json"
  Call un.DemiurgeLog
  Goto d62
  d61:
  StrCpy $R8 "KEEP  userdata/comfy_config.json"
  Call un.DemiurgeLog
  d62:
  ; [settings] userdata/comfy_extra_paths.yaml (file)
  IfFileExists "$DemiurgeShellHome\userdata\comfy_extra_paths.yaml" 0 d65
  Delete "$DemiurgeShellHome\userdata\comfy_extra_paths.yaml"
  IfFileExists "$DemiurgeShellHome\userdata\comfy_extra_paths.yaml" d64 d63
  d63:
  StrCpy $R8 "OK    userdata/comfy_extra_paths.yaml"
  Call un.DemiurgeLog
  Goto d65
  d64:
  StrCpy $R8 "KEEP  userdata/comfy_extra_paths.yaml"
  Call un.DemiurgeLog
  d65:
  ; [settings] userdata/comfy_hosts.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\comfy_hosts.json" 0 d68
  Delete "$DemiurgeShellHome\userdata\comfy_hosts.json"
  IfFileExists "$DemiurgeShellHome\userdata\comfy_hosts.json" d67 d66
  d66:
  StrCpy $R8 "OK    userdata/comfy_hosts.json"
  Call un.DemiurgeLog
  Goto d68
  d67:
  StrCpy $R8 "KEEP  userdata/comfy_hosts.json"
  Call un.DemiurgeLog
  d68:
  ; [settings] userdata/illustration_prompts.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\illustration_prompts.json" 0 d71
  Delete "$DemiurgeShellHome\userdata\illustration_prompts.json"
  IfFileExists "$DemiurgeShellHome\userdata\illustration_prompts.json" d70 d69
  d69:
  StrCpy $R8 "OK    userdata/illustration_prompts.json"
  Call un.DemiurgeLog
  Goto d71
  d70:
  StrCpy $R8 "KEEP  userdata/illustration_prompts.json"
  Call un.DemiurgeLog
  d71:
  ; [settings] userdata/lan_token.txt (file)
  IfFileExists "$DemiurgeShellHome\userdata\lan_token.txt" 0 d74
  Delete "$DemiurgeShellHome\userdata\lan_token.txt"
  IfFileExists "$DemiurgeShellHome\userdata\lan_token.txt" d73 d72
  d72:
  StrCpy $R8 "OK    userdata/lan_token.txt"
  Call un.DemiurgeLog
  Goto d74
  d73:
  StrCpy $R8 "KEEP  userdata/lan_token.txt"
  Call un.DemiurgeLog
  d74:
  ; [settings] userdata/mcp_config.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\mcp_config.json" 0 d77
  Delete "$DemiurgeShellHome\userdata\mcp_config.json"
  IfFileExists "$DemiurgeShellHome\userdata\mcp_config.json" d76 d75
  d75:
  StrCpy $R8 "OK    userdata/mcp_config.json"
  Call un.DemiurgeLog
  Goto d77
  d76:
  StrCpy $R8 "KEEP  userdata/mcp_config.json"
  Call un.DemiurgeLog
  d77:
  ; [settings] userdata/palette_pref.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\palette_pref.json" 0 d80
  Delete "$DemiurgeShellHome\userdata\palette_pref.json"
  IfFileExists "$DemiurgeShellHome\userdata\palette_pref.json" d79 d78
  d78:
  StrCpy $R8 "OK    userdata/palette_pref.json"
  Call un.DemiurgeLog
  Goto d80
  d79:
  StrCpy $R8 "KEEP  userdata/palette_pref.json"
  Call un.DemiurgeLog
  d80:
  ; [settings] userdata/privacy_denylist.txt (file)
  IfFileExists "$DemiurgeShellHome\userdata\privacy_denylist.txt" 0 d83
  Delete "$DemiurgeShellHome\userdata\privacy_denylist.txt"
  IfFileExists "$DemiurgeShellHome\userdata\privacy_denylist.txt" d82 d81
  d81:
  StrCpy $R8 "OK    userdata/privacy_denylist.txt"
  Call un.DemiurgeLog
  Goto d83
  d82:
  StrCpy $R8 "KEEP  userdata/privacy_denylist.txt"
  Call un.DemiurgeLog
  d83:
  ; [settings] userdata/prompt_approvals.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\prompt_approvals.json" 0 d86
  Delete "$DemiurgeShellHome\userdata\prompt_approvals.json"
  IfFileExists "$DemiurgeShellHome\userdata\prompt_approvals.json" d85 d84
  d84:
  StrCpy $R8 "OK    userdata/prompt_approvals.json"
  Call un.DemiurgeLog
  Goto d86
  d85:
  StrCpy $R8 "KEEP  userdata/prompt_approvals.json"
  Call un.DemiurgeLog
  d86:
  ; [settings] userdata/prose_style.json (file)
  IfFileExists "$DemiurgeShellHome\userdata\prose_style.json" 0 d89
  Delete "$DemiurgeShellHome\userdata\prose_style.json"
  IfFileExists "$DemiurgeShellHome\userdata\prose_style.json" d88 d87
  d87:
  StrCpy $R8 "OK    userdata/prose_style.json"
  Call un.DemiurgeLog
  Goto d89
  d88:
