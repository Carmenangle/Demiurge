{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demiurge",
  "mainBinaryName": "Demiurge",
  "version": "0.1.0",
  "identifier": "dev.demiurge.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": {
      "installer-staging/dependencies": "dependencies"
    },
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Demiurge",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNjE1NjJGOUEzMjk1RDkKUldUWmxUS2FMMVpoaXVFelZqZlZMNk9WTkI2cG90M0xpNExwMzZxTmJhM3lybGlNb3JGY2xJL3cK",
      "endpoints": [
        "https://github.com/Carmenangle/Demiurge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
