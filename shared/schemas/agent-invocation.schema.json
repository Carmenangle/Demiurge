{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiurge.local/schemas/agent-invocation.schema.json",
  "title": "AgentInvocationWire",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread_id", "workspace_mode", "message", "images", "base_url", "api_key", "model", "history"],
  "properties": {
    "thread_id": { "type": "string" },
    "workspace_mode": { "type": "string", "enum": ["story", "generate", "edit"] },
    "message": { "type": "string" },
    "images": { "type": "array", "items": { "type": "string" } },
    "image_mask": { "anyOf": [{ "$ref": "#/$defs/imageMask" }, { "type": "null" }] },
    "base_url": { "type": "string" }, "api_key": { "type": "string" }, "model": { "type": "string" }, "proxy": { "type": "string" },
    "provider_profile": { "type": "string", "enum": ["openai_compatible", "claude_compatible"] },
    "gen_base_url": { "type": "string" }, "gen_api_key": { "type": "string" }, "gen_model": { "type": "string" },
    "video_base_url": { "type": "string" }, "video_api_key": { "type": "string" }, "video_model": { "type": "string" },
    "video_mode": { "type": "string", "enum": ["", "climax", "firstlast"] },
    "embed_base_url": { "type": "string" }, "embed_api_key": { "type": "string" }, "embed_model": { "type": "string" },
    "embed_mode": { "type": "string", "enum": ["remote", "local"] },
    "embed_model_dir": { "type": "string" }, "reranker_model_dir": { "type": "string" },
    "size": { "type": "string" }, "image_quality": { "type": "string", "enum": ["auto", "low", "medium", "high"] },
    "output_dir": { "type": "string" }, "repo_id": { "type": "string" },
    "proxy_url": { "type": "string" }, "chat_proxy_url": { "type": "string" }, "gen_proxy_url": { "type": "string" },
    "video_proxy_url": { "type": "string" }, "embed_proxy_url": { "type": "string" },
    "route_model": { "type": "string" }, "message_id": { "type": "string" }, "user_message_id": { "type": "string" },
    "style_template": { "type": "string" }, "agent_id": { "type": "string" }, "stream_output": { "type": "boolean" },
    "context_max_tokens": { "type": "integer", "minimum": 0 }, "history_per_role": { "type": "integer", "minimum": 1, "maximum": 50 }, "selfheal_attempts": { "type": "integer", "minimum": 0, "maximum": 5 },
    "history": { "type": "array", "items": { "$ref": "#/$defs/historyItem" } },
    "approval_id": { "type": "string" }, "approval_action": { "type": "string", "enum": ["", "submit", "change", "cancel"] },
    "edited_prompt": { "type": "string" }, "forced_route": { "type": "string" },
    "character_dir": { "type": "string" }, "card_name": { "type": "string" },
    "card_names": { "type": "array", "items": { "type": "string" } }, "opening_card_name": { "type": "string" },
    "preset_dir": { "type": "string" }, "preset_name": { "type": "string" },
    "user_name": { "type": "string" }, "user_persona": { "type": "string" }, "persona_bound": { "type": "boolean" },
    "worldbook_dir": { "type": "string" }, "worldbook_name": { "type": "string" },
    "illustrate": { "type": "boolean" }, "comfy_illustrate": { "type": "boolean" }, "comfy_audio": { "type": "boolean" }, "comfy_video": { "type": "boolean" }, "prompt_profile": { "type": "string" },
    "appearance_source": { "type": "string", "enum": ["worldbook", "character_card"] },
    "character_base_images": { "type": "object", "additionalProperties": { "type": "string" } },
    "illustration_actor_names": { "type": "array", "items": { "type": "string" } }, "style_base_image": { "type": "string" },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachmentItem" } }
  },
  "$defs": {
    "imageMask": { "type": "object", "additionalProperties": false, "required": ["image", "mask"], "properties": { "image": { "type": "string" }, "mask": { "type": "string" } } },
    "historyItem": { "type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": { "role": { "type": "string", "enum": ["user", "assistant"] }, "content": { "type": "string" } } },
    "attachmentItem": { "type": "object", "additionalProperties": false, "required": ["file_id", "name", "mime", "size"], "properties": { "file_id": { "type": "string" }, "name": { "type": "string" }, "mime": { "type": "string" }, "size": { "type": "integer" } } }
  }
}
